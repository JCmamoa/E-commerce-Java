<?xml version="1.0" encoding="UTF-8"?>
<project name="ecommerce-ml" default="build" basedir=".">
    <target name="build" description="Build and test the project with Maven">
        <exec executable="mvn" failonerror="true" failifexecutionfails="true">
            <arg value="--batch-mode"/>
            <arg value="verify"/>
        </exec>
    </target>
</project>
